{
  "name": "@binder-project-planner/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/schema.d.ts"
    },
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "build": "pnpm generate",
    "generate": "openapi-typescript openapi.yaml -o src/schema.d.ts",
    "typecheck": "pnpm generate --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
